<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/cxl/pos/getsources" method="GET">
        <service class="Anyhow\CxlPos\Api\SourcesInterface" method="getSources" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/cxl/pos/getproducts" method="GET">
        <service class="Anyhow\CxlPos\Api\ProductInterface" method="getproducts"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/cxl/pos/getstores" method="GET">
        <service class="Anyhow\CxlPos\Api\StoreInterface" method="getStorelist"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/cxl/pos/categories" method="GET">
        <service class="Anyhow\CxlPos\Api\CategoryRepositoryInterface" method="getCategorieslist"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/cxl/pos/getcountry" method="GET">
        <service class="Anyhow\CxlPos\Api\CountryStateRepositoryInterface" method="getCountriesAndStates"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
   <!-- create cart Api -->
    <route url="/V1/cxl/pos/create/cartid" method="POST">
        <service class="Anyhow\CxlPos\Api\CartManagementInterface" method="createEmptyCartForCustomer"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
        <data>
            <parameter name="customerId" force="true">%customer_id%</parameter>
        </data>
    </route>
</routes>
