<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">supermax_pincode_master_form.pincode_master_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Pincode Data</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Anyhow\SupermaxPos\Block\Adminhtml\PincodeMaster\Edit\SaveButton"/>
            <button name="reset" class="Anyhow\SupermaxPos\Block\Adminhtml\PincodeMaster\Edit\ResetButton"/>
            <button name="back" class="Anyhow\SupermaxPos\Block\Adminhtml\PincodeMaster\Edit\BackButton"/>
        </buttons>
        <namespace>supermax_pincode_master_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>supermax_pincode_master_form.pincode_master_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="pincode_master_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="supermax/pincodemaster/save"/>
        </settings>
        <dataProvider class="Anyhow\SupermaxPos\Model\PincodeMaster\DataProvider" name="pincode_master_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label/>
        </settings>
        <field name="entity_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">PincodeMaster</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
        <field name="pincode" sortOrder="20" formElement="input">
            <argument name="data" xsi:type="array">
            </argument>
            <settings>
                <dataType>text</dataType>
                <label translate="true">Pincode</label>
                <dataScope>pincode</dataScope>
                <!-- <elementTmpl>Anyhow_SupermaxPos/form/element/custom-button</elementTmpl> -->
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="pattern" xsi:type="string">^[0-9]{6}$</rule>
                </validation>
            </settings>
        </field>
